    "test": "npm run test:sim && npm run test:display && npm run test:rewards && npm run test:rnd && npm run test:tyre-wear && npm run test:corner-cut && npm run test:competitive && npm run test:player-save && npm run test:programme && npm run test:mastery && npm run test:pb-ghost && npm run test:online-track-limit && npm run test:online-reconnect && npm run test:leaderboard-runs && npm run test:car-stage-dispose && npm run test:live",
    "rl:train": "node scripts/rl-train.mjs",
    "preparty:deploy": "npm run tracks:export && npm run sim:browser && npm run test:sim",
