{
  "name": "kartblitz-online",
  "private": true,
  "type": "module",
  "scripts": {
    "party:dev": "wrangler dev",
    "party:deploy": "wrangler deploy",
    "tracks:export": "node scripts/build/export-track-bakes.mjs",
    "test:track-publish": "node sim/__tests__/track-publish.test.mjs",
    "sim:browser": "node scripts/build-online-sim.mjs",
    "test:sim": "node sim/__tests__/parity.test.mjs",
    "test:display": "node sim/__tests__/display-smooth.test.mjs",
    "test:rewards": "node sim/__tests__/rewards.test.mjs",
    "test:rnd": "node sim/__tests__/rnd-progress.test.mjs",
    "test:tyre-wear": "node sim/__tests__/tyre-wear.test.mjs",
    "test:corner-cut": "node sim/__tests__/corner-cut.test.mjs",
    "test:competitive": "node sim/__tests__/competitive-upgrades.test.mjs",
    "test:live": "node sim/__tests__/online-live.integration.test.mjs",
    "test:player-save": "node sim/__tests__/player-save.test.mjs",
    "test:programme": "node sim/__tests__/upgrade-programme.test.mjs",
    "test:mastery": "node sim/__tests__/track-mastery.test.mjs",
    "test:pb-ghost": "node sim/__tests__/pb-ghost.test.mjs",
    "test:replay": "node sim/__tests__/lap-replay.test.mjs",
    "test:archive": "node sim/__tests__/lap-archive.test.mjs",
    "test:online-track-limit": "node sim/__tests__/online-track-limit.test.mjs",
    "test:online-reconnect": "node --experimental-strip-types sim/__tests__/online-reconnect.test.mjs",
    "test:leaderboard-runs": "node --experimental-strip-types sim/__tests__/leaderboard-runs.test.mjs",
    "test:car-stage-dispose": "node sim/__tests__/car-stage-dispose.test.mjs",
    "test:speed-feel": "node sim/__tests__/speed-feel.test.mjs",
    "test:ml": "node sim/__tests__/ml-runtime.test.mjs && node sim/__tests__/ml-download.test.mjs && python -m unittest ml_training.test_environment",
    "test:unit": "npm run test:display && npm run test:rewards && npm run test:rnd && npm run test:tyre-wear && npm run test:corner-cut && npm run test:competitive && npm run test:player-save && npm run test:programme && npm run test:mastery && npm run test:pb-ghost && npm run test:replay && npm run test:archive && npm run test:online-track-limit && npm run test:online-reconnect && npm run test:leaderboard-runs && npm run test:car-stage-dispose && npm run test:speed-feel && npm run test:ml",
    "test:browser": "playwright test",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:sim && npm run test:browser && npm run test:live",
    "rl:train": "python -m ml_training.train",
    "ml:trainer": "python -m ml_training.server",
    "official:core": "node scripts/build-official-core.mjs",
    "official:install": "powershell -ExecutionPolicy Bypass -File ml_training/official-install.ps1",
    "official:campaign": "powershell -ExecutionPolicy Bypass -File ml_training/campaign-start.ps1",
    "official:v2": "node scripts/ai-training/train-energy.mjs",
    "official:pace": "node scripts/ai-training/pace-rnd.mjs",
    "official:refine": "node scripts/ai-training/refine-policy.mjs",
    "official:develop": "node scripts/ai-training/develop-pace.mjs",
    "official:race-rnd": "node scripts/ai-training/race-rnd.mjs",
    "test:native-isolation": "node scripts/testing/test-native-isolation.mjs",
    "official:seed": "node scripts/ai-training/seed-policy.mjs",
    "official:imitate": "node scripts/ai-training/distill-pace.mjs",
    "test:pace": "node scripts/testing/test-pace.mjs",
    "test:energy": "node scripts/testing/test-energy.mjs",
    "official:start": "powershell -ExecutionPolicy Bypass -File ml_training/official-start.ps1",
    "test:official": "node scripts/testing/test-official.mjs",
    "preparty:deploy": "npm run tracks:export && npm run sim:browser && npm run test:sim",
    "deploy:online": "npm run party:deploy",
    "backup:leaderboard": "node scripts/leaderboards/backup-leaderboard.mjs",
    "recordings:export": "node scripts/leaderboards/export-lap-recordings.mjs",
    "seed:online-wins": "node scripts/leaderboards/seed-online-wins.mjs",
    "assets:build": "node scripts/build/vendor-client.mjs",
    "build:web": "npm run assets:build && node scripts/build/prepare-game.mjs public --web",
    "build:game": "npm run assets:build && node scripts/build/prepare-game.mjs",
    "desktop:prepare": "npm run assets:build && node scripts/build/prepare-game.mjs desktop/game",
    "desktop:dev": "npm run desktop:prepare && electron desktop",
    "desktop:build": "npm run desktop:prepare && electron-builder --config electron-builder.yml",
    "test:desktop": "npm run desktop:prepare && playwright test --config desktop/playwright.config.mjs",
    "test:activities": "node --test core/activity-host.test.mjs desktop/asset-policy.test.cjs sim/__tests__/customisation.test.mjs",
    "test:runtime": "node scripts/build/verify-runtime.mjs",
    "test:portable": "node desktop/portable-smoke.mjs"
  },
  "dependencies": {
    "partyserver": "^0.5.10",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@fontsource/nunito": "5.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.14.0"
  },
  "version": "1.0.0",
  "description": "KartBlitz browser racing and reusable activity shell"
}
